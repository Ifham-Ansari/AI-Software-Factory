{
  "components": {
    "schemas": {
      "CreateProjectRequest": {
        "additionalProperties": false,
        "description": "Create a project.",
        "example": {
          "description": "Inventory, orders and staff scheduling.",
          "name": "Restaurant System"
        },
        "properties": {
          "description": {
            "default": "",
            "maxLength": 2000,
            "title": "Description",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "CreateProjectRequest",
        "type": "object"
      },
      "DependencyResponse": {
        "additionalProperties": false,
        "description": "One dependency's state.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Exception type when unhealthy. Never a driver message, which can contain a connection string.",
            "title": "Detail"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "title": "DependencyResponse",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "description": "The error itself.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable machine-readable error identifier."
          },
          "details": {
            "additionalProperties": true,
            "description": "Structured context. Never contains secrets.",
            "title": "Details",
            "type": "object"
          },
          "fields": {
            "description": "Field-level problems, for validation failures.",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Fields",
            "type": "array"
          },
          "message": {
            "description": "Human-readable description, safe to display.",
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Correlates this response with server logs.",
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "description": "Stable error identifiers returned in the API error envelope.",
        "enum": [
          "validation_failed",
          "malformed_request",
          "invalid_credentials",
          "token_expired",
          "token_invalid",
          "token_reused",
          "not_authenticated",
          "forbidden",
          "not_found",
          "already_exists",
          "conflict",
          "rate_limited",
          "database_unavailable",
          "service_unavailable",
          "configuration_invalid",
          "internal_error"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "description": "A single field-level validation problem.",
        "properties": {
          "field": {
            "description": "Dotted path to the offending field.",
            "title": "Field",
            "type": "string"
          },
          "message": {
            "description": "What is wrong with it.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Envelope returned for every non-2xx response.",
        "example": {
          "error": {
            "code": "not_found",
            "details": {},
            "fields": [],
            "message": "The requested project was not found.",
            "request_id": "3f9a2c1b8e5d4a7f"
          }
        },
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Liveness. Answers only 'is this process running', and touches nothing external.",
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "environment"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MessageResponse": {
        "additionalProperties": false,
        "description": "A bare acknowledgement, for endpoints with nothing else to return.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageResponse",
        "type": "object"
      },
      "PageMeta": {
        "additionalProperties": false,
        "description": "Pagination metadata, kept separate from the items themselves.\n\nClients need totals to render controls; nesting them alongside the array rather than\ninside it keeps the item schema clean.",
        "properties": {
          "has_next": {
            "title": "Has Next",
            "type": "boolean"
          },
          "has_previous": {
            "title": "Has Previous",
            "type": "boolean"
          },
          "page": {
            "description": "Current page, 1-based.",
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "description": "Items per page.",
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "description": "Total items matching the query.",
            "title": "Total",
            "type": "integer"
          },
          "total_pages": {
            "description": "Total pages available.",
            "title": "Total Pages",
            "type": "integer"
          }
        },
        "required": [
          "page",
          "page_size",
          "total",
          "total_pages",
          "has_next",
          "has_previous"
        ],
        "title": "PageMeta",
        "type": "object"
      },
      "PaginatedResponse_ProjectResponse_": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProjectResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "required": [
          "items",
          "meta"
        ],
        "title": "PaginatedResponse[ProjectResponse]",
        "type": "object"
      },
      "ProjectResponse": {
        "additionalProperties": false,
        "description": "A project, as returned to clients.\n\n``owner_id`` is deliberately omitted: a caller can only ever see their own projects,\nso it carries no information and including it would invite clients to build\nownership logic that belongs on the server.",
        "properties": {
          "archived_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "description",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "ProjectResponse",
        "type": "object"
      },
      "ProjectStatus": {
        "description": "Lifecycle state of a project.\n\nPhase 1 covers creation and archival only. Later phases add the states that describe\nan active build (specifying, building, deployed); they are not modelled yet because\nnothing can reach them.",
        "enum": [
          "draft",
          "archived"
        ],
        "title": "ProjectStatus",
        "type": "string"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "description": "Readiness. Answers 'can this process serve traffic', and probes dependencies.",
        "properties": {
          "dependencies": {
            "items": {
              "$ref": "#/components/schemas/DependencyResponse"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "description": "Exchange a refresh token for a new session.",
        "properties": {
          "refresh_token": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "description": "Create an account.",
        "example": {
          "display_name": "Ada Lovelace",
          "email": "ada@example.com",
          "password": "a-sufficiently-long-passphrase"
        },
        "properties": {
          "display_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "description": "Email address. Normalised to lowercase.",
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "description": "At least 12 characters. Length is the requirement rather than character-class rules, which push users toward predictable substitutions.",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "display_name"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "SessionResponse": {
        "additionalProperties": false,
        "description": "A newly established session.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Access-token lifetime in seconds.",
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_expires_in": {
            "description": "Refresh-token lifetime in seconds.",
            "title": "Refresh Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "user",
          "access_token",
          "refresh_token",
          "expires_in",
          "refresh_expires_in"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SignInRequest": {
        "additionalProperties": false,
        "description": "Authenticate an existing account.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignInRequest",
        "type": "object"
      },
      "SignOutRequest": {
        "additionalProperties": false,
        "description": "Revoke a session.",
        "properties": {
          "refresh_token": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "SignOutRequest",
        "type": "object"
      },
      "SortDirection": {
        "description": "Sort direction.",
        "enum": [
          "asc",
          "desc"
        ],
        "title": "SortDirection",
        "type": "string"
      },
      "UpdateProjectRequest": {
        "additionalProperties": false,
        "description": "Partially update a project.\n\nOmitted fields are left unchanged. An explicit empty description clears it.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "title": "UpdateProjectRequest",
        "type": "object"
      },
      "UserResponse": {
        "additionalProperties": false,
        "description": "A user, as returned to clients.\n\nBuilt from the domain entity, which structurally cannot carry a password hash.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "status",
          "created_at"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Access token issued by /auth/sign-in",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "\nControl-plane API for the AI Software Factory.\n\nEvery error response uses a single envelope with a stable `error.code`; branch on that\nrather than on status text. Every response carries an `X-Request-ID` header that\ncorrelates it with server logs.\n",
    "title": "AI Software Factory API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/me": {
      "get": {
        "description": "Return the authenticated user.",
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Current user",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "description": "Exchange a refresh token for a new session.\n\nThe presented token is consumed: a successor is issued and the old one is retired.\nPresenting a retired token is treated as theft and revokes the whole session family.",
        "operationId": "refresh_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Refresh a session",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "description": "Register a new account and return a session.\n\nRegistration signs the user straight in. Requiring a separate sign-in immediately\nafter would add a round trip and a second chance to mistype the password, for no\nsecurity benefit \u2014 the credentials were just verified.",
        "operationId": "register_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Create an account",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/sign-in": {
      "post": {
        "description": "Exchange credentials for a session.\n\nAn unknown email and a wrong password produce the same error, after the same amount\nof work, so this endpoint cannot be used to discover which addresses are registered.",
        "operationId": "sign_in_auth_sign_in_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Authenticate",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/sign-out": {
      "post": {
        "description": "Revoke a refresh token.\n\nIdempotent, and deliberately indistinguishable for a token that never existed:\nreporting the difference would tell an unauthenticated caller whether a token is real.",
        "operationId": "sign_out_auth_sign_out_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignOutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Revoke a session",
        "tags": [
          "auth"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Report that this process is running.\n\nTouches nothing external. A failure here means the process itself is broken and\nshould be restarted \u2014 which is exactly why it must not probe the database. An\norchestrator that restarts pods because Postgres blipped turns a brief database\nproblem into a full outage.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
