{
  "name": "@factory/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from the API's OpenAPI schema. Never hand-edited.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi.json -o ./src/api.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.7.0"
  }
}
