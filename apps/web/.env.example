# Frontend environment template — copy to .env.local
#
# NEXT_PUBLIC_* is embedded in the browser bundle and readable by anyone.
# NEVER put a secret in a NEXT_PUBLIC_ variable.
#
# There are no secrets here at all, and that is by design: the browser never calls the
# API directly. Server Actions proxy every request, so tokens live in httpOnly cookies
# set by the Next.js server.

API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_MS=30000
