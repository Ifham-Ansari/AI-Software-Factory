# AI Software Factory — environment template
#
# ⚠️  THIS FILE IS COMMITTED TO GIT. It must only ever contain placeholders.
#     Copy it to `.env` and put real values there — `.env` is gitignored.
#
#       cp .env.example .env
#
# The application FAILS TO START if a required variable is missing, and the error names
# every offending variable.
#
# Naming: variables are grouped by section with a double underscore
# (DATABASE__POOL_SIZE). The handful with well-known conventional names also accept the
# flat form (DATABASE_URL, JWT_SECRET_KEY), which is what deployment platforms expect.

# =============================================================================
# REQUIRED — Phase 1
# =============================================================================

# --- Database ---------------------------------------------------------------
# Neon connection string. A plain postgresql:// URL is rewritten to the psycopg driver
# automatically, so a pasted Neon string works unmodified.
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Security ---------------------------------------------------------------
# Signs access tokens. At least 32 characters; startup refuses anything shorter.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotating this invalidates every issued access token. Refresh tokens survive, because
# they are opaque random strings rather than signed claims — users stay signed in.
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_value_at_least_32_chars

# --- Secrets (envelope encryption) -------------------------------------------
# Encrypts every credential a project stores. Required for the secret vault; without it
# the platform still runs and storing a secret returns 503 rather than falling back to
# storing it in the clear.
#
# Generate:  uv run python scripts/generate_master_key.py
#
# ⚠️  LOSING THIS KEY MAKES EVERY STORED SECRET PERMANENTLY UNRECOVERABLE. It is never
#     written to the database, so a database backup does not contain it. Back it up
#     before storing anything real — see docs/runbooks/key-management.md.
SECRETS__MASTER_KEY=

# Retired keys, comma-separated, kept only during a rotation so existing data still
# decrypts. See the runbook; rotation is online and needs no downtime.
SECRETS__PREVIOUS_KEYS=

# --- Email (registration verification codes) ---------------------------------
# Registration emails a 6-digit code and the account cannot sign in until it is redeemed,
# so this is what decides whether signup works at all.
#
# transport=console  → the code is WRITTEN TO THE API LOG, not emailed. No account
#                      needed. Fine on a dev machine; production refuses to start with it
#                      because it puts a live credential into a log aggregator.
# transport=smtp     → real mail. Requires EMAIL__SMTP_HOST and, for any real provider,
#                      a username and password.
EMAIL__TRANSPORT=console

# Who the mail comes from. With Gmail this MUST be the account that authenticates below,
# or Google rewrites/rejects it.
EMAIL__FROM_ADDRESS=no-reply@example.com
EMAIL__FROM_NAME=AI Software Factory

# Gmail:    smtp.gmail.com   port 587   TLS on
# Outlook:  smtp.office365.com   port 587   TLS on
# Mailtrap/Mailpit and other dev catchers: see their dashboard, usually no TLS.
EMAIL__SMTP_HOST=
EMAIL__SMTP_PORT=587
EMAIL__SMTP_USERNAME=
# ⚠️  For Gmail this is NOT your Google account password — that has been rejected for SMTP
#     since 2022. Generate a 16-character App Password (needs 2-Step Verification on):
#     https://myaccount.google.com/apppasswords
EMAIL__SMTP_PASSWORD=
EMAIL__SMTP_USE_TLS=true

# --- Verification code policy ------------------------------------------------
# Security parameters, not preferences. A 6-digit code is only ~20 bits; what protects it
# is the attempt limit and the expiry, so loosen these deliberately or not at all.
VERIFICATION__CODE_LENGTH=6
VERIFICATION__TTL_SECONDS=600
VERIFICATION__MAX_ATTEMPTS=6
VERIFICATION__RESEND_COOLDOWN_SECONDS=60
VERIFICATION__MAX_PER_DAY=10

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# All optional. Redis is consumed today; OpenAI and LangSmith are accepted and validated
# now so the credentials have a correct, redacted home before Phase 3 writes the clients
# that use them. Leaving any of them unset changes nothing.
# /ready reports on each dependency that is configured.

# --- Redis (events fan-out, rate limiting, idempotency, locks) ---------------
# Optional: with no Redis the platform still works and every event is still durable in
# Postgres — a browser picks up what it missed by replaying over REST. Redis buys latency,
# not correctness.
#
# ⚠️  Upstash requires TLS: the URL must be rediss://, not redis://. A plaintext redis://
#     URL to an Upstash host is closed by the server during the handshake, and because
#     fan-out is allowed to be unavailable the platform degrades quietly rather than
#     failing loudly — you get working software with silently dead live updates.
#     REDIS_API_KEY is accepted as an alias, since that is what Upstash's console calls it.
REDIS_URL=

# --- OpenAI (Phase 3: agent inference) --------------------------------------
OPENAI_API_KEY=
# Optional: override the API base, for a proxy or a gateway.
OPENAI__BASE_URL=

# --- LangSmith (Phase 3: tracing and evaluation) ----------------------------
# LANGSMITH_API_KEY is the current name; LANGCHAIN_API_KEY is the legacy alias and is
# still accepted. Tracing stays off unless LANGSMITH_TRACING is true.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-software-factory

# =============================================================================
# OPTIONAL — shown with their defaults
# =============================================================================

# --- Environment ------------------------------------------------------------
# development | test | staging | production
# `production` refuses to start with API docs enabled, wildcard CORS, console logging,
# or SQL echo. Those are the settings most often left on by accident.
ENVIRONMENT=development

# --- Database pooling -------------------------------------------------------
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=5
DATABASE__POOL_TIMEOUT_SECONDS=10
DATABASE__POOL_RECYCLE_SECONDS=1800
# Logs every SQL statement. Never enable in production; startup rejects it there.
DATABASE__ECHO=false

# --- Tokens and hashing -----------------------------------------------------
# Access tokens are short-lived on purpose: they are stateless, so revocation is not
# immediate. The long-lived half of a session is the stateful, rotating refresh token.
SECURITY__ACCESS_TOKEN_TTL_SECONDS=600
SECURITY__REFRESH_TOKEN_TTL_SECONDS=2592000

# Argon2id cost. Defaults follow OWASP's second recommended configuration (19 MiB, t=2,
# p=1) — roughly 50 ms per hash on typical server hardware. Raise memory before time.
SECURITY__ARGON2_TIME_COST=2
SECURITY__ARGON2_MEMORY_COST_KIB=19456
SECURITY__ARGON2_PARALLELISM=1

# --- HTTP -------------------------------------------------------------------
API__HOST=127.0.0.1
API__PORT=8000
# Comma-separated or a JSON array. Must not be "*" in production.
API__CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Serves /docs, /redoc and /openapi.json. Must be false in production.
API__DOCS_ENABLED=true
# Set when running behind a proxy that strips a path prefix.
API__ROOT_PATH=
# How long a single /ready dependency probe may take. Raise it for a serverless or
# distant database, where opening a fresh connection can take several seconds.
API__HEALTH_TIMEOUT_SECONDS=15

# --- Observability ----------------------------------------------------------
OBSERVABILITY__LOG_LEVEL=INFO
# json for machine consumption, console for local readability. Must be json in production.
OBSERVABILITY__LOG_FORMAT=console
OBSERVABILITY__SERVICE_NAME=factory-api
OBSERVABILITY__OTEL_ENABLED=false
OBSERVABILITY__OTEL_ENDPOINT=

# =============================================================================
# TESTS
# =============================================================================
# Integration tests need a real PostgreSQL database and are SKIPPED without this.
# They cover what in-memory fakes cannot: that the generated SQL actually scopes by
# owner, that constraints and cascades behave as declared, and that migrations reverse.
#
# ⚠️  The target database is WIPED on every run. Point it at a throwaway — a dedicated
#     Neon branch, or a local container. NEVER at the database in DATABASE_URL.
#
#   docker run -d --name factory-test-db -e POSTGRES_PASSWORD=postgres \
#     -p 5432:5432 postgres:17-alpine
#
TEST_DATABASE_URL=

# --- Redis for the integration suite ----------------------------------------
# Set to run the fan-out tests rather than skip them. They cover what the in-memory fake
# cannot: real subscriptions, blocking reads, socket timeouts, and delivery from one
# connection to another. CI always sets it.
#
#   docker run -d --name factory-test-redis -p 6379:6379 redis:7-alpine
#
# Only ephemeral pub/sub channels are used, so this is safe to point at any Redis — but
# prefer a throwaway anyway.
TEST_REDIS_URL=

# =============================================================================
# FRONTEND (apps/web/.env.local)
# =============================================================================
# Origin the browser opens the event WebSocket against. Defaults to API_BASE_URL with
# http swapped for ws, which is correct for local development. Set it explicitly when the
# API is behind a different public hostname than the one the Next.js server dials.
#
# Deliberately not NEXT_PUBLIC_: the value is returned by the authenticated ws-ticket
# route rather than compiled into the bundle.
# WS_BASE_URL=ws://127.0.0.1:8000

# =============================================================================
# FRONTEND (apps/web) — copy to apps/web/.env.local
# =============================================================================
# NEXT_PUBLIC_* is embedded in the browser bundle and readable by anyone.
# NEVER put a secret in a NEXT_PUBLIC_ variable.
#
# API_BASE_URL is deliberately NOT public: the browser never calls the API directly.
# Server Actions proxy every call, so tokens stay in httpOnly cookies that browser
# JavaScript cannot read.
#
# API_BASE_URL=http://127.0.0.1:8000
